# Copie este arquivo para ".env" e ajuste os valores. O ".env" nunca vai para o git.
# Use so letras e numeros nos valores: o Docker Compose interpreta "$" de forma especial.

# --- Banco (usado pelo compose.yaml) ---
POSTGRES_DB=brumi
POSTGRES_USER=brumi
POSTGRES_PASSWORD=troque-esta-senha

# --- Seguranca da API ---
# Chave que assina os tokens JWT. Obrigatoria, minimo 32 caracteres, aleatoria.
# Gerar no PowerShell (64 caracteres hexadecimais, gerador criptograficamente seguro):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# Validade do token em minutos (padrao 1440 = 24 h).
JWT_EXPIRACAO_MINUTOS=1440
# Origens que podem chamar a API pelo navegador (separe por virgula).
CORS_ORIGENS=http://localhost:4200

# --- Administrador inicial (criado na primeira subida, se ainda nao existir) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
